{
  "acceptance-scenario": "1",
  "name": "removal-keeps-commitments",
  "purpose": "Removing a member refuses their new circle-only requests while their approved reservation and their pending request both carry on.",
  "verifies": [
    "::BorrowBox.Lending.LendingCircles.MembershipChangesKeepCommitments",
    "::BorrowBox.Lending.Library.CircleService",
    "::BorrowBox.Lending.Library.BorrowingService"
  ],
  "test": "::BorrowBox.CircleAccessTests",
  "environment": "LocalDevelopment",
  "given": [
    {
      "step": "system.start",
      "text": "the library is running with the demo seed"
    },
    {
      "step": "circle.accept",
      "args": {
        "as": "jo",
        "circle": "Riverside Neighbours"
      },
      "text": "Jo joins Riverside Neighbours"
    },
    {
      "step": "loan.approved",
      "args": {
        "owner": "sam",
        "as": "jo",
        "item": "bike",
        "from": "+20",
        "to": "+21",
        "ref": "c"
      },
      "text": "Sam approves Jo's request for days 20-21"
    },
    {
      "step": "request.submit",
      "args": {
        "as": "jo",
        "item": "bike",
        "from": "+10",
        "to": "+11",
        "ref": "r"
      },
      "text": "Jo also asks for days 10-11"
    }
  ],
  "when": [
    {
      "step": "circle.remove",
      "args": {
        "as": "maya",
        "circle": "Riverside Neighbours",
        "member": "jo"
      },
      "text": "Maya, the organiser, removes Jo"
    }
  ],
  "then": [
    {
      "step": "request.submitExpectRefusal",
      "args": {
        "as": "jo",
        "item": "bike",
        "from": "+30",
        "to": "+31",
        "status": 403
      },
      "text": "Jo cannot make a new request"
    },
    {
      "step": "loan.status",
      "args": {
        "ref": "c",
        "status": "approved"
      },
      "text": "her approved reservation is untouched"
    },
    {
      "step": "request.act",
      "args": {
        "as": "sam",
        "ref": "c",
        "action": "ready"
      },
      "text": "and moves on: Sam marks it ready"
    },
    {
      "step": "request.act",
      "args": {
        "as": "sam",
        "ref": "r",
        "action": "approve"
      },
      "text": "her pending request is still Sam’s to approve"
    }
  ],
  "trace": {
    "from": "::BorrowBox.Lending.Library.RemoveMember"
  }
}
