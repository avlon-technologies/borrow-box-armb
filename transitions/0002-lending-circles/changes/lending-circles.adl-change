  add into #6e386931-3a6d-4df5-a086-20f6e8e555fe {
    record MembershipAct v1 #f5200b8a-f7c9-4ed1-9274-ee26741681f0 { circleId: text }
  }
  add into #db3fea2b-58de-496b-8543-362669e9e18b {
    capability LendingCircles #fb597acf-8fce-4a6a-a98c-8f6c598933d9 {
      desc "Small groups of friends forming circles, inviting each other, and choosing whether an item is offered to everybody or only to the circles its owner belongs to."

      requirement CircleOnlyItemsReachOnlyMembers #5dd6564a-3a95-4c41-9e02-f998b7c1dff1 {
        desc "An item offered only to circles is shown to, and can be requested by, only people who at that moment share one of its circles with its owner."
      }
      requirement CirclesGrowByInvitation #1319dc8f-c339-47f1-a002-d4f5771263d6 {
        desc "Any member may start a circle and becomes its organiser; people join only by accepting an invitation from a current member; only the organiser removes members, and the organiser always stays a member."
      }
      requirement MembershipChangesKeepCommitments #4ebfe140-18a8-42bc-a1d2-5cea523aed65 {
        desc "Leaving, removal, or narrowing an item's audience refuses new circle-only requests from then on, but every reservation already made, pending or committed, continues through decision, handoff, extension and return unchanged."
      }
      requirement OwnersChooseAudience #741f5597-c5db-452b-8546-14b195421185 {
        desc "Only an item's owner decides whether it is offered to everybody or only to chosen circles, and only circles the owner currently belongs to can be chosen."
      }
    }
  }
