change lendingCircles core adl/1.7 {
  desc "Lending circles. Friends form circles, invite members and share items with everybody or only with their circles. Circle-only requests need a circle shared with the owner at the moment of the request; leaving, removal or narrowing an audience refuses new circle-only requests and never touches reservations already made. Derived by continuum diff from an authored state B (ids preserved), then renamed and described."
  base package avlon.borrowbox version "cycle-1" state "sha256:8ae3819b488c8639ce39955a41a7303c6f8cd4f360c74f65849a61deb1055a5f"
  result state "sha256:2a970ccbcbf7166fcfbbd5a243cad584c7b1a07b646beba57defa39643be61a7"

  modify #1ea05f05-2422-4e12-b16c-da31ea3b18d8 description = "Anyone exploring the catalog can see each item offered to them, with its photo, owner, lending rules and the dates already committed. (A01)"
  modify #2830e21f-ec6b-4801-b58d-e08c7fd4c5a6 attributes.admissions = [#01f174c5-e84b-4d9f-82c2-d0a660682cc8 requires #6e2a4a98-0df9-467e-91ca-f65cd376a97e for itemId, #acecfcf6-c0fc-4331-bee5-68e973d4da20 for itemId]
  modify #6e386931-3a6d-4df5-a086-20f6e8e555fe description = "The authority for items, their reservations, loans, condition evidence, the circles items are shared through, and the history of who did what. Circles live here because whether a request is admitted depends on membership at the same instant the request is recorded."
  modify #6f1d9389-7b0f-445f-b9a8-a1c414658f15 description = "Every listed item with its owner, rules, photo, visibility, audience (everybody or circles only) and the circles it is shared with. Hiding or narrowing the audience is a setting, never a deletion."
  modify #bfe9b77a-a1ef-4afa-8bc7-49f9ed1b8c52 attributes.reactions = [#167750da-bb94-4a52-8bf5-0f03cc4fde01 -> none; #33b53430-8f5f-4501-a6ec-f9744e5ddaa9 -> none; #8cef42b6-bf53-41c9-b856-3f97c9bba877 -> none; #ca3e05e5-eb4a-45cc-b7bd-86421859a1a8 -> all-of #ea179f54-23bf-4b95-bf0c-2e248be895ec correlate #ea179f54-23bf-4b95-bf0c-2e248be895ec payload.itemId = payload.itemId]
  add into #6e386931-3a6d-4df5-a086-20f6e8e555fe {
    business-rule ShareOnlyWhereMember #052fedf4-9902-4f09-b071-d24d094406ea {
      statement "An owner can share an item only with circles they are an active member of; an item offered only to circles is reachable through a circle only while its owner is still an active member there."
    }
  }
  add into #6e386931-3a6d-4df5-a086-20f6e8e555fe {
    event MemberRemoved #068514be-fc34-4960-9572-7fa833b99361 {
      desc "The person is no longer a member. Nothing they already arranged changes."
      delivery[ordered; at-least-once; durable]
      payload = #298b7ea5-b56b-44e8-8687-7aa9324428e7
    }
  }
  add into #6e386931-3a6d-4df5-a086-20f6e8e555fe {
    record OpenInvitation v1 #1ae8f340-01f4-4e8b-802a-793d0beb7eeb { circleId: text, inviteeId: text }
  }
  add into #69416aaa-49b7-45cd-b672-a28741a73b6d {
    actor Member #20f8ef09-ac3d-4d39-936f-94723db443c4 [person] {
      desc "Anyone using BorrowBox, before any item or reservation gives them the owner's or the borrower's part. Circles are formed, joined and looked after by members."
      uses: #69416aaa-49b7-45cd-b672-a28741a73b6d
    }
  }
  add into #6e386931-3a6d-4df5-a086-20f6e8e555fe {
