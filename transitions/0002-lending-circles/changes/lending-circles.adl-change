      on #bb696d05-3507-46d2-9579-53a6e2c33559 -> all-of #068514be-fc34-4960-9572-7fa833b99361 correlate #068514be-fc34-4960-9572-7fa833b99361 payload.circleId = payload.circleId
      on #d1675e8f-eba6-4b58-b15b-71ea1c448339 -> none
      on #e679e237-e47d-43cf-811c-44dbca98ab3d -> all-of #e8f19758-5792-44f7-afd1-6c15887123df correlate #e8f19758-5792-44f7-afd1-6c15887123df payload.name = payload.name
