    test CircleAccessTests #f4518af0-98e6-4103-97ac-9cb4493e36ed {
      desc "Circle-only items are seen and requested only through a shared circle; removal, leaving and narrowing the audience refuse new requests while pending and committed reservations continue to return; removal racing a request."
      verifies: #44a92019-ffa6-4a31-8725-29d9b823dcea, #4ebfe140-18a8-42bc-a1d2-5cea523aed65, #5dd6564a-3a95-4c41-9e02-f998b7c1dff1, #741f5597-c5db-452b-8546-14b195421185, #bfe9b77a-a1ef-4afa-8bc7-49f9ed1b8c52
