    business-rule OnlyMembersInvite #9f744b16-47e1-4f58-893e-240a111eeaa8 {
      statement "Only an active member may invite, and only someone not already invited or active in that circle; only the invited person accepts or declines."
    }
  }
  add into #6e386931-3a6d-4df5-a086-20f6e8e555fe {
    record ItemReach v1 #acecfcf6-c0fc-4331-bee5-68e973d4da20 { itemId: text, requesterId: text }
  }
  add into #6e386931-3a6d-4df5-a086-20f6e8e555fe {
    resource CircleStore #b20d3d27-629b-4ddb-96fd-019a01271372 [data-store] {
      desc "Every circle with its organiser, and every membership with its standing (invited, active, declined, left, removed). Ending a membership changes its standing; nothing is deleted. It also keeps each circle's own append-only activity, kept apart from the loan journal so that one service writes each store."
      persistence[durable; strong]
    }
  }
  add into #6e386931-3a6d-4df5-a086-20f6e8e555fe {
