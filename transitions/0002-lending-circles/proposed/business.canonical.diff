>     rule CircleOnlyNeedsSharedCircle #r-1004 {
>       scope RequestToBorrow
>       condition Item.audience == Audience "CirclesOnly"
>       assertion "the request is refused unless, at the moment it is made, the requester and the owner are both active members of a circle the item is shared with"
>     }
> 
>     rule MembershipChangesKeepCommitments #r-1005 {
>       scope RemoveMember
>       condition Membership.standing == MembershipStatus "Active"
>       assertion "removal refuses that person's new circle-only requests from now on; every reservation already made, pending or committed, continues through decision, handoff, extension and return unchanged"
>     }
> 
>     rule LeavingKeepsCommitments #r-1006 {
>       scope LeaveCircle
>       condition Membership.standing == MembershipStatus "Active"
>       assertion "leaving refuses new circle-only requests through that circle, in either direction; reservations already made continue unchanged"
>     }
> 
>     rule ShareOnlyWhereMember #r-1007 {
>       scope ChooseAudience
>       condition Item.audience == Audience "CirclesOnly"
>       assertion "an item can be shared only with circles its owner is an active member of; narrowing the audience never touches reservations already made"
>     }
> 
>     rule OnlyMembersInvite #r-1008 {
>       scope InviteToCircle
>       condition Membership.standing == MembershipStatus "Invited"
>       assertion "only an active member of the circle may invite, and only someone who is not already invited or active there"
>     }
> 
