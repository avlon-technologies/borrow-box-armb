64a76,81
>     capability LendWithinCircles #c-1005 {
>       purpose {
>         "let groups of friends form circles, invite each other, and offer items to everybody or only to the circles they belong to"
>       }
>     }
> 
83a101
>       audience: Audience
218a237,314
>     entity Circle #en-1006 {
>       description "A small group of friends who lend to each other. The person who creates it is its organiser."
>       identity circleId
>       circleId: text
>       name: text
>       organiser: Person
>     }
> 
>     entity Membership #en-1007 {
>       description "One person's standing in one circle. Its history is kept: leaving or being removed ends the standing, it never erases it."
>       identity membershipId
>       membershipId: text
>       circle: Circle
>       member: Person
>       standing: MembershipStatus
> 
>       state-model MembershipLifecycle for standing #sm-1004 {
>         initial Invited
> 
>         transition Join #t-1031 {
>           from Invited
>           to Active
>           triggeredBy AcceptInvitation
>           produces InvitationAccepted
>         }
> 
>         transition Refuse #t-1032 {
>           from Invited
>           to Declined
>           triggeredBy DeclineInvitation
>           produces InvitationDeclined
>         }
> 
>         transition Leave #t-1033 {
>           from Active
>           to Left
>           triggeredBy LeaveCircle
>           produces MemberLeft
>         }
> 
>         transition Remove #t-1034 {
>           from Active
>           to Removed
>           triggeredBy RemoveMember
>           produces MemberRemoved
>         }
> 
>         transition ReinviteDeclined #t-1035 {
>           from Declined
>           to Invited
>           triggeredBy InviteToCircle
>           produces MemberInvited
>         }
> 
>         transition ReinviteLeft #t-1036 {
>           from Left
>           to Invited
>           triggeredBy InviteToCircle
>           produces MemberInvited
>         }
> 
>         transition ReinviteRemoved #t-1037 {
>           from Removed
>           to Invited
>           triggeredBy InviteToCircle
>           produces MemberInvited
>         }
>       }
>     }
> 
>     entity CircleShare #en-1008 {
