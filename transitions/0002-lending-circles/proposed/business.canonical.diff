>     action CreateCircle [permitted] #ac-1019 {
>       description "Any member starts a circle and becomes its organiser and first active member."
>       mayPerform Member
>       exercises LendWithinCircles
>       creates Circle
>       produces CircleCreated
>     }
> 
>     action InviteToCircle [permitted] #ac-1020 {
>       description "A current member of a circle invites someone who is not currently a member."
>       mayPerform Member
>       exercises LendWithinCircles
>       targets Circle
>       creates Membership
>       produces MemberInvited
>       outcome { Membership.standing == MembershipStatus "Invited" }
>     }
> 
>     action AcceptInvitation [permitted] #ac-1021 {
>       mayPerform Member
>       exercises LendWithinCircles
>       targets Membership
>       changes Membership
>       produces InvitationAccepted
>       precondition { Membership.standing == MembershipStatus "Invited" }
>     }
> 
>     action DeclineInvitation [permitted] #ac-1022 {
>       mayPerform Member
>       exercises LendWithinCircles
>       targets Membership
>       changes Membership
>       produces InvitationDeclined
>       precondition { Membership.standing == MembershipStatus "Invited" }
>     }
> 
>     action LeaveCircle [permitted] #ac-1023 {
>       description "A member other than the organiser steps out of a circle."
>       mayPerform Member
>       exercises LendWithinCircles
>       targets Membership
>       changes Membership
>       produces MemberLeft
>       precondition { Membership.standing == MembershipStatus "Active" }
>     }
> 
>     action RemoveMember [permitted] #ac-1024 {
>       description "The organiser removes a member. New circle-only requests from that person stop; what they already arranged continues."
>       mayPerform Organiser
>       exercises LendWithinCircles
>       targets Membership
>       changes Membership
>       produces MemberRemoved
>       precondition { Membership.standing == MembershipStatus "Active" }
>     }
> 
>     action ChooseAudience [permitted] #ac-1025 {
>       description "The owner offers an item to everybody, or only to the circles they choose among those they belong to."
>       mayPerform Owner
>       exercises LendWithinCircles
>       targets Item
>       creates CircleShare
>       changes Item
>       produces ItemAudienceChanged
>     }
> 
>     action CancelOnMembershipChange [forbidden] #ac-1026 {
>       description "Named so a reader finds it: leaving, removal, or narrowing an item's audience never cancels, declines or stalls a reservation already made."
>       targets Reservation
>     }
