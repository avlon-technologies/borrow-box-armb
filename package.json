{
  "name": "borrowbox",
  "version": "1.0.0",
  "private": true,
  "description": "BorrowBox — a warm, trustworthy lending library for friends and small communities.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm install && npm run build && npm run seed",
    "seed": "node server/src/seed.js --reset",
    "build": "vite build",
    "start": "node server/src/index.js",
    "dev": "node server/src/dev.js",
    "test": "node --test --test-concurrency=1 \"server/test/*.test.js\"",
    "test:e2e": "playwright test",
    "test:acceptance": "node continuum/acceptance/run.mjs --adapter continuum/acceptance/adapter.mjs",
    "test:all": "npm test && npm run test:acceptance && npm run test:e2e"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.5"
  }
}
